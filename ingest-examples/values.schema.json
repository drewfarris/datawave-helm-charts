{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "existing": {
      "type": "object",
      "required": [
        "sharedConfigClaim",
        "ingestEnvConfigMap",
        "hadoopConfigMap",
        "accumuloConfigMap",
        "gendersConfigMap",
        "credentialsSecret",
        "credentialsKey"
      ],
      "properties": {
        "sharedConfigClaim": {
          "type": "string",
          "minLength": 1
        },
        "ingestEnvConfigMap": {
          "type": "string",
          "minLength": 1
        },
        "hadoopConfigMap": {
          "type": "string",
          "minLength": 1
        },
        "accumuloConfigMap": {
          "type": "string",
          "minLength": 1
        },
        "gendersConfigMap": {
          "type": "string",
          "minLength": 1
        },
        "credentialsSecret": {
          "type": "string",
          "minLength": 1
        },
        "credentialsKey": {
          "type": "string",
          "minLength": 1
        },
        "sharedConfigMap": {
          "type": "string"
        }
      }
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
      "minLength": 1,
      "maxLength": 10
    },
    "job": {
      "type": "object",
      "properties": {
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "ttlSecondsAfterFinished": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "examples": {
      "type": "object",
      "properties": {
        "datasets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "wikipedia",
              "annotation",
              "json",
              "csv",
              "wikipedia-medium",
              "wikipedia-de",
              "wikipedia-es",
              "wikipedia-fr"
            ]
          }
        },
        "numShards": {
          "type": "integer",
          "minimum": 1
        },
        "hdfsBaseDirectory": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9_/-]+$"
        },
        "extraIngestOptions": {
          "type": "string"
        },
        "allowExpectedCsvErrors": {
          "type": "boolean"
        },
        "createTables": {
          "type": "boolean"
        }
      }
    },
    "additionalLibraries": {
      "type": "string"
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "jobCache": {
      "type": "object",
      "required": [
        "directory"
      ],
      "properties": {
        "directory": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(/|hdfs://)"
        }
      }
    }
  }
}
